# Local default (without docker)
COURSES_DATABASE_URL=sqlite:///./courses.db

# Docker/Postgres example:
# COURSES_DATABASE_URL=postgresql+psycopg2://courses_user:courses_pass@localhost:5432/courses_db

# OpenAI-compatible provider settings
# OPENAI_API_KEY=<provider_api_key>
# OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1
# YANDEX_FOLDER_ID=<your_folder_id>
