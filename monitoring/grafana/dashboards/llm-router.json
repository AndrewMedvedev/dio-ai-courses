{
  "uid": "llm-router",
  "title": "LLM Router — Traces",
  "description": "Слева — запросы, справа — вызовы выбранного запроса, ниже — Input / Output выбранного вызова. Связь по request_id; порядок по дате сохранения, без выдуманной вложенности.",
  "schemaVersion": 39,
  "version": 4,
  "tags": [
    "llm",
    "tracing"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "invocation_id",
        "label": "Выбранный вызов",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Нагрузка",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "title": "Сохранённые LLM-вызовы / с",
      "type": "timeseries",
      "description": "Скорость записи invocation logs, включая выбор модели. Не HTTP RPS: created_at — время сохранения.",
      "datasource": {
        "type": "postgres",
        "uid": "llm_postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "llm_postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1m'), count(*) / 60.0 AS \"Вызовы / с\" FROM public.llm_invocations WHERE deleted_at IS NULL AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Токены сохранённых вызовов / с",
      "type": "timeseries",
      "description": "total_tokens из логов; разделение input/output и потоковая скорость генерации отсутствуют.",
      "datasource": {
        "type": "postgres",
        "uid": "llm_postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "llm_postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1m'), sum(total_tokens) / 60.0 AS \"Total tokens / с\" FROM public.llm_invocations WHERE deleted_at IS NULL AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Статистика по моделям",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "llm_postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "llm_postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT model AS \"Model\", count(*) AS \"Вызовы\", count(*) FILTER (WHERE upper(status::text) = 'FAILED') AS \"Ошибки\", sum(total_tokens) AS \"Total tokens\", round(avg(duration_ms)::numeric, 1) AS \"Среднее, мс\" FROM public.llm_invocations WHERE deleted_at IS NULL AND $__timeFilter(created_at) GROUP BY model ORDER BY count(*) DESC",
          "format": "table"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 10
      }
    },
    {
      "id": 5,
      "title": "Ошибки и задержки",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      }
    },
    {
      "title": "Доля успешных и ошибочных LLM-вызовов",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "llm_postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "llm_postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1m'), count(*) FILTER (WHERE upper(status::text) = 'FAILED')::double precision / count(*) AS \"Failed rate\", count(*) FILTER (WHERE upper(status::text) = 'COMPLETED')::double precision / count(*) AS \"Success rate\" FROM public.llm_invocations WHERE deleted_at IS NULL AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "P50 / P95 / P99 сохранённых вызовов",
      "type": "timeseries",
      "description": "duration_ms из записи вызова; не TTFT и не длительность всей генерации курса.",
      "datasource": {
        "type": "postgres",
        "uid": "llm_postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "llm_postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1m'), percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) / 1000.0 AS \"P50\", percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) / 1000.0 AS \"P95\", percentile_cont(0.99) WITHIN GROUP (ORDER BY duration_ms) / 1000.0 AS \"P99\" FROM public.llm_invocations WHERE deleted_at IS NULL AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "Traces / Request / Response",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "title": "Traces / Запросы",
      "description": "Одна строка — общий request_id. Нажмите «Открыть», чтобы увидеть связанные вызовы. Последние 500 запросов за выбранный период.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "llm_postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT (array_agg(id ORDER BY created_at, id))[1]::text AS id, request_id::text AS \"Request ID\", max(created_at) AS \"Дата\", count(*) AS \"Вызовы\", CASE WHEN bool_or(status::text = 'FAILED') THEN 'FAILED' ELSE 'COMPLETED' END AS \"Статус\" FROM public.llm_invocations WHERE deleted_at IS NULL AND $__timeFilter(created_at) GROUP BY request_id ORDER BY max(created_at) DESC, request_id DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace"
              },
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "data-links"
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Открыть",
                    "url": "/d/llm-router/llm-router?from=${__from}&to=${__to}&var-invocation_id=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Статус"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "COMPLETED": {
                        "text": "✓ Completed",
                        "color": "green"
                      },
                      "FAILED": {
                        "text": "✕ Failed",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true
      }
    },
    {
      "id": 10,
      "title": "Вызовы выбранного запроса → выберите шаг",
      "description": "Все сохранённые вызовы с тем же request_id, включая вызовы за пределами выбранного периода. Нумерация по дате сохранения, не дерево родительских связей. Нажмите «Открыть» для Input / Output.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "llm_postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 29,
        "w": 16,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT id::text AS id, row_number() OVER (ORDER BY created_at, id) AS \"Шаг\", CASE WHEN id = NULLIF(${invocation_id:sqlstring}, '')::uuid THEN '▶ ' ELSE '' END || model AS \"Вызов / Модель\", status::text AS \"Статус\", duration_ms AS \"Время, мс\", total_tokens AS \"Токены\", created_at AS \"Сохранён\" FROM public.llm_invocations WHERE deleted_at IS NULL AND request_id = (SELECT request_id FROM public.llm_invocations WHERE id = NULLIF(${invocation_id:sqlstring}, '')::uuid AND deleted_at IS NULL) ORDER BY created_at, id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Выбрать"
              },
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "data-links"
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Открыть",
                    "url": "/d/llm-router/llm-router?from=${__from}&to=${__to}&var-invocation_id=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Статус"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "COMPLETED": {
                        "text": "✓ Completed",
                        "color": "green"
                      },
                      "FAILED": {
                        "text": "✕ Failed",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true
      }
    },
    {
      "id": 11,
      "title": "Запрос / Input — ${invocation_id}",
      "description": "Полный сохранённый JSON без обрезания. Откройте просмотр значения ячейки, чтобы прочитать или скопировать весь запрос.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "llm_postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT jsonb_pretty(request) AS \"Запрос\" FROM public.llm_invocations WHERE id = NULLIF(${invocation_id:sqlstring}, '')::uuid AND deleted_at IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "json-view"
            },
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
    },
    {
      "id": 12,
      "title": "Ответ / Output — ${invocation_id}",
      "description": "Ответ той же записи без обрезания. Для failed отдельно показана сохранённая ошибка. Откройте просмотр значения ячейки для полного JSON.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "llm_postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT jsonb_pretty(response) AS \"Ответ\", COALESCE(error, '') AS \"Ошибка\" FROM public.llm_invocations WHERE id = NULLIF(${invocation_id:sqlstring}, '')::uuid AND deleted_at IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "json-view"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ошибка"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
    },
    {
      "id": 13,
      "title": "Ресурсы общего backend (LLM Router не отдельный контейнер)",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 1
      }
    },
    {
      "title": "CPU контейнеров",
      "type": "timeseries",
      "description": "В ядрах CPU; 1 = одно полностью занятое ядро.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_main"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_main"
          },
          "editorMode": "code",
          "expr": "sum by (container_label_com_docker_compose_service,name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_label_com_docker_compose_project=~\"dio-ai-courses(-local)?\",container_label_com_docker_compose_service=~\"backend\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{name}}",
          "instant": false,
          "range": true
        }
      ],
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "RAM контейнеров",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_main"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_main"
          },
          "editorMode": "code",
          "expr": "sum by (container_label_com_docker_compose_service,name) (container_memory_working_set_bytes{job=\"cadvisor\",container_label_com_docker_compose_project=~\"dio-ai-courses(-local)?\",container_label_com_docker_compose_service=~\"backend\"})",
          "refId": "A",
          "legendFormat": "{{name}}",
          "instant": false,
          "range": true
        }
      ],
      "id": 15,
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
