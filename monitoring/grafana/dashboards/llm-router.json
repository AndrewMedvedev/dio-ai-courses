        "w": 12,
        "h": 8
      }
    },
    {
      "title": "OOM за период",
      "type": "timeseries",
      "description": "OOM events cAdvisor; отсутствие серии не означает ноль.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_main"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_main"
          },
          "editorMode": "code",
          "expr": "sum by (container_label_com_docker_compose_service,name) (increase(container_oom_events_total{job=\"cadvisor\",container_label_com_docker_compose_project=~\"dio-ai-courses(-local)?\",container_label_com_docker_compose_service=~\"backend\"}[$__range]))",
          "refId": "A",
