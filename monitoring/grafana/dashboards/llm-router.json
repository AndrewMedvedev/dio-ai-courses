          },
          "editorMode": "code",
          "expr": "sum by (container_label_com_docker_compose_service,name) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",container_label_com_docker_compose_project=~\"dio-ai-courses(-local)?\",container_label_com_docker_compose_service=~\"backend\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "Отправка — {{name}}",
          "instant": false,
          "range": true
        }
      ],
      "id": 16,
      "gridPos": {
        "x": 0,
