      }
    },
    {
      "title": "Приём и отправка по сети",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_main"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_main"
          },
          "editorMode": "code",
          "expr": "sum by (container_label_com_docker_compose_service,name) (rate(container_network_receive_bytes_total{job=\"cadvisor\",container_label_com_docker_compose_project=~\"dio-ai-courses(-local)?\",container_label_com_docker_compose_service=~\"backend\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "Приём — {{name}}",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
