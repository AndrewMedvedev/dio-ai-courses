          },
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_service=~\"$container_service\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "description": "Requires cAdvisor label container_label_com_docker_compose_service. If empty in Explore, adapt to the label exported by your Docker runtime."
